# TLSOC Alert Emailer - all configuration lives here.
#
#   cp .env.example .env && chmod 600 .env && $EDITOR .env
#
# This file holds passwords, so the script refuses to start unless it is
# mode 600. It is in .gitignore - keep it that way.
#
# Check what the script actually parsed, with secrets masked:
#   python3 tlsoc_alert_emailer.py show-config

# ---------------------------------------------------------------------------
# 1. Where the alerts come from
# ---------------------------------------------------------------------------

# Your Kibana, with port. Use the HOST_IP, not localhost: the server cert lists
# the DNS name and the host IP, so https://localhost:5601 fails hostname
# verification. Alerts are read via Kibana's detection-engine search API.
KIBANA_URL=https://192.168.1.10:5601

# The Kibana space the alerts live in. Alerts are per-space, and on a real
# deploy the default space is usually EMPTY - the space id is in your Kibana
# URL as /s/<space-id>/. Getting this wrong returns zero alerts and looks
# exactly like a quiet night.
KIBANA_SPACE=default

# OPTIONAL, and it takes priority when set: query Elasticsearch directly
# instead of going through Kibana. A pure read-only ES role (see README) has no
# Kibana privileges, so if `check` returns 403 against Kibana, set this.
ES_URL=

# Defaults to .alerts-security.alerts-<KIBANA_SPACE>. Always the alias, never a
# numbered backing index like ...-000008: that rolls over and alerts stop.
ALERT_INDEX=

# Read-only account (README has the exact role to create). Never `elastic`.
ES_USERNAME=tlsoc_alert_reader
ES_PASSWORD=

# TLS. Point TLS_CA_CERT at your stack's CA so the certificate is verified;
# leave it empty to use the system trust store. TLS_VERIFY=false disables
# checking entirely - testing only, and it logs a warning every run.
TLS_VERIFY=true
TLS_CA_CERT=certs/ca.crt
REQUEST_TIMEOUT=30

# ---------------------------------------------------------------------------
# 2. Which rules to email about
# ---------------------------------------------------------------------------

# Comma-separated. From Kibana > Security > Rules > <rule>: either the rule_id
# or the UUID in the URL - both are matched, so whichever you copied works.
# An alert whose rule is not in this list is ignored.
RULE_IDS=brute-force-authentication, 00000000-1111-2222-3333-444444444444

# ---------------------------------------------------------------------------
# 3. Who gets emailed
# ---------------------------------------------------------------------------

# Everyone here gets every matched alert.
EMAIL_TO=soc-team@example.org

# OPTIONAL extra recipients for specific rules, added on top of EMAIL_TO:
#   RULE_ROUTES=rule-id:a@example.org|b@example.org; other-rule-id:c@example.org
# Every rule id used here must also appear in RULE_IDS.
RULE_ROUTES=

# Sending account. For Gmail, SMTP_PASSWORD must be a 16-character App Password
# (https://myaccount.google.com/apppasswords), never your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=
SMTP_TIMEOUT=30

# OPTIONAL: only for an internal relay whose cert is signed by a private CA.
SMTP_CA_CERT=

# Defaults to SMTP_USERNAME when empty.
EMAIL_FROM=
# Available tokens: {rule_name} {rule_id} {severity} {risk_score} {host} {host_or_ip} {user} {timestamp}
EMAIL_SUBJECT_TEMPLATE=[TLSOC][{severity}] {rule_name} on {host_or_ip}

# ---------------------------------------------------------------------------
# 4. The polling window
# ---------------------------------------------------------------------------

# How far back a run looks. Match this to your cron interval (cron every 10
# min -> 10). This is the value to edit if you change the schedule.
LOOKBACK_MINUTES=10

# With USE_CHECKPOINT=true the window actually runs from where the last cycle
# finished, so a late or skipped run still catches up and drops nothing;
# LOOKBACK_MINUTES is then the first window and the fallback. Set it to false
# for a strict "last N minutes" window every time.
USE_CHECKPOINT=true

# Re-scan this many seconds before the checkpoint, so an alert indexed a moment
# late is not missed. Duplicates are filtered by alert ID, not by time.
OVERLAP_SECONDS=30

# If the script was down longer than this, skip ahead instead of replaying days.
MAX_CATCHUP_HOURS=24

# Blast-radius cap: one noisy rule cannot emit thousands of emails and get the
# SMTP account throttled. The remainder arrives on the next cycle.
MAX_ALERTS_PER_RUN=200

# ---------------------------------------------------------------------------
# 5. Files
# ---------------------------------------------------------------------------

STATE_FILE=state/state.json
LOG_FILE=logs/alert_emailer.log
LOG_LEVEL=INFO
